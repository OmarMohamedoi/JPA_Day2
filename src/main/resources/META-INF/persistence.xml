<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="empPU" transaction-type="RESOURCE_LOCAL">
        <class>org.example.entity.Author</class>
        <class>org.example.entity.Book</class>
        <properties>
            <!-- Database connection strings -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:mem:empdb"/>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>

            <!-- Underlying Hibernate configurations -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
